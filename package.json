{
  "name": "flixer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flixer: movies and TV shows across all genres.",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/product.js flixer dev",
    "build": "node scripts/product.js flixer build",
    "start": "node scripts/product.js flixer start",
    "refresh-data": "node scripts/refresh-providers.js --product flixer",
    "export": "node scripts/product.js flixer export",
    "build:static": "node scripts/product.js flixer build",
    "publish": "npx netlify-cli deploy --prod --build",
    "snapshot:save": "node scripts/snapshot.js save",
    "snapshot:restore": "node scripts/snapshot.js restore",
    "dev:flixer": "node scripts/product.js flixer dev",
    "start:flixer": "node scripts/product.js flixer start",
    "export:flixer": "node scripts/product.js flixer export",
    "build:flixer": "node scripts/product.js flixer build",
    "test": "node --test server/test/*.test.js",
    "refresh:providers": "node scripts/refresh-providers.js --product flixer",
    "refresh:providers:full": "node scripts/refresh-providers.js --product flixer --full",
    "build:mobile": "node scripts/product.js flixer mobile-web"
  },
  "dependencies": {
    "@streamparser/json": "0.0.22",
    "cheerio": "^1.2.0",
    "json5": "^2.2.3",
    "youtubei.js": "^15.0.1"
  }
}
