{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/product.js flixer vercel",
  "outputDirectory": "client/dist-flixer",
  "installCommand": "npm ci --prefix client && npm ci --prefix server",
  "framework": null,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/data/catalog(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/data/status.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/data/shows/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/shows/:id.json",
      "destination": "/api/saved-title?id=:id"
    },
    {
      "source": "/((?!data/|assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{server/deployment-flixer.json,server/deployment-titles/**}",
      "maxDuration": 60,
      "excludeFiles": "{server/data/**,client/public/**,client/dist*/**,client-terrarium/dist*/**,mobile/**,docs/**}"
    },
    "api/saved-title.js": {
      "includeFiles": "server/deployment-titles/**",
      "maxDuration": 15,
      "excludeFiles": "{server/data/**,server/deployment-flixer.json,client/**,client-terrarium/**,mobile/**,docs/**}"
    },
    "api/stream.js": {
      "includeFiles": "{server/deployment-flixer.json,server/deployment-titles/**}",
      "maxDuration": 60,
      "excludeFiles": "{server/data/**,client/public/**,client/dist*/**,client-terrarium/dist*/**,mobile/**,docs/**}"
    }
  },
  "env": {
    "APP_PRODUCT": "flixer"
  }
}
